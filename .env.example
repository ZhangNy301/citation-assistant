# Semantic Scholar API Key
# 获取免费 API Key: https://www.semanticscholar.org/product/api/api-key
# 初始配额通常为跨接口共享 1 次/秒；实际以服务端配额为准，带 Key 仍可能 429
S2_API_KEY=your_key_here

# HTTP 429 有界重试（不重试 401/403）；不提供 Retry-After 时按 2、4 秒退避
S2_MAX_RETRIES=2
S2_RETRY_DELAY=2
# 服务端要求等待更久时直接停止，不提前重试；0 次重试可禁用重试
S2_MAX_RETRY_DELAY=60
